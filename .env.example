# Development uses a persistent local signing key when SECRET_KEY is unset.
HMS_ENV=development
SECRET_KEY=
# Use an absolute SQLite path in production; set a random SECRET_KEY of at least 32 characters.
# DATABASE_URL=sqlite:////absolute/path/hms.db
HMS_DEBUG=false
HMS_ENABLE_DEMO_LOGIN=false
HMS_SMS_LIVE=false
PAYSTACK_SECRET_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Public HTTPS origin for staff onboarding links.
HMS_BASE_URL=
